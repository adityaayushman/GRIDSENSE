# Comma-separated origins allowed to call the API from a browser.
# In production set this to the deployed frontend URL, e.g.
# ALLOWED_ORIGINS=https://gridsense.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to true once you have a WattTime API token and want live data
USE_LIVE_DATA=false
WATTTIME_TOKEN=

# Optional Postgres connection for persisting simulation runs
DATABASE_URL=postgresql://gridsense:gridsense@localhost:5432/gridsense
