# Comma-separated origins allowed to call the API from a browser.
# In production set this to the deployed frontend URL, e.g.
# ALLOWED_ORIGINS=https://gridsense-app-adityaasahoo-gmailcoms-projects.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Live carbon intensity from the ENTSO-E Transparency Platform.
# Register at transparency.entsoe.eu, then email transparency@entsoe.eu to
# request API access — they issue the security token on request.
# Regions supported: ES, FR, DE, PT (see app/entsoe.py DOMAINS).
USE_LIVE_DATA=false
ENTSOE_TOKEN=

# Optional Postgres connection for persisting simulation runs
DATABASE_URL=postgresql://gridsense:gridsense@localhost:5432/gridsense
